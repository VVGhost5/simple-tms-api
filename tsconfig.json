{
  "compilerOptions": {
    "rootDir": "src",        // Повертаємо src як головну папку з кодом
    "outDir": "./dist",
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src/**/*"],    // Тільки код додатку для компіляції
  "exclude": [
    "node_modules",
    "prisma.config.ts"        // Виключаємо конфіг з процесу білду
  ]
}