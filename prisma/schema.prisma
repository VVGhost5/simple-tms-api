// prisma/schema.prisma

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Editor
  Admin
}

enum TripStatus {
  Planned
  Loading
  Customs
  InTransitToPickup
  InTransitToDelivery
  Delivered
  Completed
  Cancelled
}

enum EmissionStandard {
  EURO_1 @map("Євро-1")
  EURO_2 @map("Євро-2")
  EURO_3 @map("Євро-3")
  EURO_4 @map("Євро-4")
  EURO_5 @map("Євро-5")
  EURO_6 @map("Євро-6")
  EURO_7 @map("Євро-7")
}

// Ukrainian driving licence categories (PDR / HSC), without A/A1 (motorcycles) and T (tram/trolleybus).
enum LicenseCategory {
  B1
  B
  BE
  C1
  C
  C1E
  CE
  D1
  D
  D1E
  DE
}

enum OwnershipType {
  a       @map("Є власником")
  b       @map("Не є власником")
  special
}

enum VehicleCategory {
  N2
  N3
  O3
  O4
}

model Vehicle {
  id                    String            @id @default(uuid())
  licensePlate          String
  make                  String
  model                 String
  type                  String?
  commercialDescription String?
  vinCode               String?
  chassisNumber         String?
  maximumMass           Int?
  emptyMass             Int?
  vehicleCategory       VehicleCategory?
  capacity              Int?
  bodyType              String?
  fuelType              String?
  maximumPower          Int?
  emissionStandart      EmissionStandard?
  color                 String?
  numberOfSeats         Int?
  specialMarks          String?
  firstRegistrationDate DateTime?
  registrationDate      DateTime?
  surnameOrCompany      String?
  givenNames            String?
  manufacturingYear     Int?
  address               String?
  ownership             OwnershipType?
  registrationCode      String?
  periodOfValidity      DateTime?
  tsc                   Int?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  semiTrailerId String?      @unique
  semiTrailer   SemiTrailer? @relation(fields: [semiTrailerId, tenantId], references: [id, tenantId])

  driver Driver?
  trips  Trip[]

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@unique([id, tenantId])
  @@unique([tenantId, licensePlate])
  @@unique([tenantId, vinCode])
  @@unique([semiTrailerId, tenantId])
  @@index([tenantId])
}

model SemiTrailer {
  id                    String            @id @default(uuid())
  licensePlate          String
  make                  String
  model                 String
  type                  String?
  commercialDescription String?
  vinCode               String?
  chassisNumber         String?
  maximumMass           Int?
  emptyMass             Int?
  vehicleCategory       VehicleCategory?
  capacity              Int?
  bodyType              String?
  fuelType              String?
  maximumPower          Int?
  emissionStandart      EmissionStandard?
  color                 String?
  numberOfSeats         Int?
  specialMarks          String?
  firstRegistrationDate DateTime?
  registrationDate      DateTime?
  surnameOrCompany      String?
  givenNames            String?
  manufacturingYear     Int?
  address               String?
  ownership             OwnershipType?
  registrationCode      String?
  periodOfValidity      DateTime?
  tsc                   Int?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  vehicle Vehicle?

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@unique([id, tenantId])
  @@unique([tenantId, licensePlate])
  @@unique([tenantId, vinCode])
  @@index([tenantId])
}

model Driver {
  id                String            @id @default(uuid())
  firstName         String
  lastName          String
  licenseNumber     String
  categories        LicenseCategory[]
  phone             String
  email             String?
  birthDate         DateTime
  licenseExpiryDate DateTime
  status            String            @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currentVehicleId String?  @unique
  currentVehicle   Vehicle? @relation(fields: [currentVehicleId, tenantId], references: [id, tenantId])

  trips Trip[]

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@unique([id, tenantId])
  @@unique([currentVehicleId, tenantId])
  @@unique([tenantId, licenseNumber])
  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@index([tenantId])
}

model Trip {
  id        String     @id @default(uuid())
  driverId  String
  vehicleId String
  status    TripStatus @default(Planned)

  driver  Driver  @relation(fields: [driverId, tenantId], references: [id, tenantId])
  vehicle Vehicle @relation(fields: [vehicleId, tenantId], references: [id, tenantId])

  loads   TripLoad[]
  unloads TripUnload[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@unique([id, tenantId])
  @@index([tenantId])
}

model Goods {
  id           String       @id @default(uuid())
  descrpiption String
  volume       String
  weight       String
  isADR        Boolean
  tripLoads    TripLoad[]
  tripUnloads  TripUnload[]
}

model TripLoad {
  id       String   @id @default(uuid())
  tripId   String
  date     DateTime
  location String
  goodsId  String?
  goods    Goods?   @relation(fields: [goodsId], references: [id])

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripUnload {
  id       String   @id @default(uuid())
  tripId   String
  date     DateTime
  location String
  goodsId  String?
  goods    Goods?   @relation(fields: [goodsId], references: [id])

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(Editor)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  vehicles     Vehicle[]
  semiTrailers SemiTrailer[]
  drivers      Driver[]
  trips        Trip[]

  @@index([tenantId])
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  vehicles     Vehicle[]
  semiTrailers SemiTrailer[]
  drivers      Driver[]
  trips        Trip[]
}
